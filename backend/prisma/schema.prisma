// =======================================================
// EthiopiaHub Images
// Prisma Schema
// Version: 2.1
// Sprint 1 + Sprint 2
// Status: Approved
// =======================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =======================================================
// Enums
// =======================================================

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

enum SessionStatus {
  ACTIVE
  REVOKED
}

enum ImageVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum ImageStatus {
  ACTIVE
  DELETED
}

enum StorageProvider {
  LOCAL
  CLOUDINARY
}

enum ContributorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}



// =======================================================
// Authentication
// =======================================================

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(50)
  description String? @db.Text

  createdAt DateTime @default(now())

  users User[]

  @@map("roles")
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  username     String @unique @db.VarChar(50)
  email        String @unique @db.VarChar(255)
  passwordHash String @db.VarChar(255)

  emailVerified Boolean    @default(false)
  status        UserStatus @default(PENDING)

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  //---------------------------------------
  // Relations
  //---------------------------------------

  sessions           UserSession[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]

  images Image[]
  contributorApplication ContributorApplication?

  profile                    UserProfile?
likes                      ImageLike[]
favorites                  Favorite[]
downloads                  Download[]

  //---------------------------------------
  // Indexes
  //---------------------------------------

  @@index([email])
  @@index([username])
  @@index([status])
  @@map("users")
}

model ContributorApplication {
  id String @id @default(uuid()) @db.Uuid

  //---------------------------------------
  // Applicant
  //---------------------------------------

  userId String @unique @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  //---------------------------------------
  // Application
  //---------------------------------------

  message String? @db.Text

  status ContributorApplicationStatus @default(PENDING)

  //---------------------------------------
  // Admin Review
  //---------------------------------------

  reviewedById String? @db.Uuid

  reviewedAt DateTime?

  adminNote String? @db.Text

  //---------------------------------------
  // Audit
  //---------------------------------------

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("contributor_applications")
}

model UserSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String @db.VarChar(255)

  deviceName String? @db.VarChar(100)
  ipHash     String? @db.VarChar(255)
  userAgent  String? @db.Text

  expiresAt DateTime

  revokedAt DateTime?

  status SessionStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model EmailVerification {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique @db.VarChar(255)

  expiresAt DateTime

  verifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verifications")
}

model PasswordReset {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique @db.VarChar(255)

  expiresAt DateTime

  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_resets")
}

// =======================================================
// Image Management
// Sprint 2
// =======================================================

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(100)
  slug        String  @unique @db.VarChar(120)
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images Image[]

  @@map("categories")
}

model Tag {
  id String @id @default(uuid()) @db.Uuid

  name String @unique @db.VarChar(80)

  slug String @unique @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  imageTags ImageTag[]

  @@map("tags")
}

model Image {
  id String @id @default(uuid()) @db.Uuid

  //---------------------------------------
  // Ownership
  //---------------------------------------

  ownerId String @db.Uuid

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  //---------------------------------------
  // Category
  //---------------------------------------

  categoryId String @db.Uuid

  category Category @relation(fields: [categoryId], references: [id])

  //---------------------------------------
  // Basic Information
  //---------------------------------------

  title String @db.VarChar(200)

  description String? @db.Text

  location String? @db.VarChar(200)

  //---------------------------------------
  // Storage
  //---------------------------------------

  storageProvider StorageProvider @default(LOCAL)

  originalFilename String @db.VarChar(255)

  storedFilename String @db.VarChar(255)

  storageKey String @db.VarChar(500)

  //---------------------------------------
  // File Information
  //---------------------------------------

  mimeType String @db.VarChar(100)

  extension String @db.VarChar(20)

  fileSize BigInt

  width Int

  height Int

  checksum String? @db.VarChar(128)

  //---------------------------------------
  // Metadata
  //---------------------------------------

  dominantColor String? @db.VarChar(30)

  cameraModel String? @db.VarChar(150)

  //---------------------------------------
  // Visibility
  //---------------------------------------

  visibility ImageVisibility @default(PUBLIC)

  status ImageStatus @default(ACTIVE)

  //---------------------------------------
  // Audit
  //---------------------------------------

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

//---------------------------------------
// Relations
//---------------------------------------

tags ImageTag[]

// Sprint 3
likes ImageLike[]
favorites Favorite[]
downloads Download[]

  //---------------------------------------
  // Indexes
  //---------------------------------------

  @@index([ownerId])
  @@index([ownerId, createdAt])
  @@index([categoryId])
  @@index([visibility])
  @@index([status])
  @@index([visibility, status])
  @@index([createdAt])
  @@index([ownerId, visibility])
@@index([ownerId, status])
@@index([ownerId, visibility, status])
  @@map("images")
}

model ImageTag {
  imageId String @db.Uuid

  tagId String @db.Uuid

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([imageId, tagId])
  @@index([tagId])
  @@map("image_tags")
}


model UserProfile {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String? @db.VarChar(120)

  bio String? @db.Text

  avatarUrl String? @db.VarChar(500)

  website String? @db.VarChar(500)

  location String? @db.VarChar(150)

  isPublic Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

model ImageLike {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  imageId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, imageId])

  @@index([userId])

  @@index([imageId])

  @@map("image_likes")
}

model Favorite {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  imageId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, imageId])

  @@index([userId])

  @@index([imageId])

  @@map("favorites")
}

model Download {
  id String @id @default(uuid()) @db.Uuid

  userId String? @db.Uuid

  imageId String @db.Uuid

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  ipHash String? @db.VarChar(255)

  userAgent String? @db.Text

  downloadedAt DateTime @default(now())

  @@index([userId])

  @@index([imageId])

  @@index([downloadedAt])

  @@map("downloads")
}

